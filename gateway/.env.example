# API Gateway (Dev B) — point d'entree unique du front
PORT=3000

# URLs des services en aval (relayes par la gateway).
# /!\ Aligne 3001 et 3002 avec le docker-compose.yml de A (racine du depot).
STUDENTS_SERVICE_URL="http://localhost:3001"
COURSES_SERVICE_URL="http://localhost:3002"
ENROLLMENTS_SERVICE_URL="http://localhost:3003"

# Auth (JWT) — DOIT etre identique a celui du service students
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="12h"
